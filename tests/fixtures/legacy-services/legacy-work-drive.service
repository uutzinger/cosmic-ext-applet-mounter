[Unit]
Description=Legacy work Google Drive mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount work_drive: %h/Cloud/WorkDrive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 20G \
  --cache-dir %h/.cache/rclone-work-drive
ExecStop=/bin/fusermount3 -uz %h/Cloud/WorkDrive
Restart=on-failure

[Install]
WantedBy=default.target
