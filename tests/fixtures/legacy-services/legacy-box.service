[Unit]
Description=Legacy Box mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount box_remote: %h/Cloud/Box \
  --vfs-cache-mode full \
  --vfs-cache-max-size 20G \
  --cache-dir %h/.cache/rclone-box \
  --dir-cache-time 5m
ExecStop=/bin/fusermount3 -uz %h/Cloud/Box
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
