[Unit]
Description=Legacy personal Google Drive mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount personal_drive: %h/Cloud/PersonalDrive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 20G \
  --cache-dir %h/.cache/rclone-personal-drive
ExecStop=/bin/fusermount3 -uz %h/Cloud/PersonalDrive
Restart=on-failure

[Install]
WantedBy=default.target
