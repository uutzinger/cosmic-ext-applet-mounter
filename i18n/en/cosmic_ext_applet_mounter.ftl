mount-guard-invalid-arguments = The mountpoint guard received invalid arguments.
mount-guard-invalid-id = The mountpoint guard received an invalid connection ID.
mount-guard-load-failed = Could not load the saved connection for mountpoint verification.
mount-guard-connection-removed = The connection was removed; mount was blocked.
mount-guard-connection-changed = The saved Online mount changed or was disabled; save it again before mounting.
mount-guard-inspect-mounts = Could not inspect host mounts: { $error }
