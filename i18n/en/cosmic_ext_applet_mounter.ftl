mount-guard-inspect-directory = Could not inspect mountpoint: { $error }
mount-guard-not-directory = Mountpoint `{ $path }` is not an ordinary directory; mount blocked for safety.
mount-guard-inspect-contents = Could not inspect mountpoint contents: { $error }
mount-guard-local-entries = Mountpoint `{ $path }` contains local entries. They were left untouched. Review and move them to a safe backup before mounting.
