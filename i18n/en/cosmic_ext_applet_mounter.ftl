teams-mirror-guard-blocked = SharePoint mirror blocked: { $error }
sharepoint-anchor-create-error = Could not create SharePoint mirror access marker: { $error }
sharepoint-anchor-missing = SharePoint mirror access marker is missing; repair the mirror before syncing.
sharepoint-anchor-invalid = SharePoint mirror access marker is not a regular file.
sharepoint-anchor-read-error = Could not read SharePoint mirror access marker: { $error }
sharepoint-anchor-changed = SharePoint mirror access marker changed; repair the mirror before syncing.
sharepoint-confirmation-invalidate-error = Could not invalidate the prior SharePoint mirror confirmation: { $error }
sharepoint-schedule-help = Safety: Preview is dry-run; initial synchronization requires Preview plus confirmed Sync Now before Start can enable the schedule. Scheduled runs recheck the saved SharePoint target and access marker.
sharepoint-mirror-plan-ready = Managed SharePoint mirror service { $name } validates structurally. Preview and Sync Now are available; the background timer is disabled.
rclone-mirror-saved-uninitialized = { $name } saved with managed mirror units and its schedule disabled. Run Preview and the confirmed initial Sync Now before using Start.
rclone-mirror-saved-initialized = { $name } saved with managed mirror units and its schedule disabled. Existing initialization state was preserved; Preview and Sync Now now run normal bisync. Use Start to resume scheduled synchronization.
onedrive-mirror-saved-uninitialized = { $name } saved with its managed OneDrive mirror unit disabled. Run Preview and the confirmed initial Sync Now before using Start.
onedrive-mirror-saved-initialized = { $name } saved with its managed OneDrive mirror unit disabled. Existing initialization state was preserved; Preview and Sync Now now run normal OneDrive synchronization. Use Start to resume background monitoring.
pending-count-online-help = { $count } file(s) waiting for or undergoing upload.
pending-count-mounted-connection-unavailable = Pending uploads cannot be verified while the mounted connection's network or VPN dependency is unavailable. Turn the connection off and on to recover.
pending-count-onedriver-unavailable = onedriver does not provide a reliable pending-upload count.
pending-count-unknown = Pending changes have not been checked or the count is unavailable.
pending-count-active-unknown = Active connection; pending-change count unavailable. { $reason }
pending-count-inactive-unknown = Inactive connection; pending-change count unavailable. { $reason }
pending-count-queue-unavailable = Rclone upload queue is unavailable.
pending-count-cache-unavailable = Rclone cache status is unavailable.
pending-count-response-incomplete = Rclone pending-write response is incomplete.
pending-count-request-failed = Could not build the rclone status request.
pending-count-queue-unreadable = Rclone upload queue response is unreadable.
pending-count-cache-unreadable = Rclone cache status response is unreadable.
pending-count-queue-missing = Rclone did not return an upload queue.
pending-count-cache-missing = Rclone did not return VFS cache status.
pending-count-cache-errors = Rclone has unresolved cache or upload errors.
pending-count-mirror-help = { $count } pending mirror change(s) in a check { $age } seconds ago. New changes may increase this number.
pending-count-mirror-live-help = Estimated { $count } change(s) remaining in the current mirror run. The count is based on reported file operations.
pending-count-mirror-unreadable = OneDrive mirror status did not provide a reliable count.
pending-count-mirror-indeterminate = OneDrive mirror status is indeterminate.
pending-count-mirror-unavailable = OneDrive mirror status is unavailable.
pending-count-rclone-mirror-unavailable = Rclone mirror preview is unavailable.
